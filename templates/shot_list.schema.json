{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "script/shot_list.json: the whole script in one file",
  "type": "object",
  "required": [
    "title",
    "target_seconds",
    "fps",
    "character_master",
    "shots",
    "vo_lines",
    "sound_cues",
    "music"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_seconds": {
      "type": "number",
      "minimum": 10,
      "maximum": 120
    },
    "fps": {
      "type": "integer",
      "enum": [
        24
      ]
    },
    "character_master": {
      "type": "string",
      "description": "path, normally stills/character_master.png"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "duration_s",
          "has_character",
          "still_prompt",
          "motion_prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "act": {
            "type": "string",
            "enum": [
              "open",
              "reveal",
              "classroom",
              "close"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "motion",
              "hero",
              "talking",
              "still"
            ],
            "description": "motion=Wan2.2-5B, hero=Wan2.2-A14B, talking=LTX-2.5, still=held image"
          },
          "duration_s": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 6
          },
          "feature_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "id from script/features.json revealed in this shot"
          },
          "still_prompt": {
            "type": "string",
            "minLength": 20
          },
          "motion_prompt": {
            "type": "string"
          },
          "talking_line": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "vo_line_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^v[0-9]{2}$"
            }
          },
          "sfx_cue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^x[0-9]{2}$"
            }
          },
          "on_screen": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_ref",
                "style"
              ],
              "additionalProperties": false,
              "properties": {
                "fact_ref": {
                  "type": "string",
                  "description": "key path into edit/facts.json, e.g. features.f03.title"
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "title",
                    "subtitle",
                    "label",
                    "chalk_curve"
                  ]
                },
                "offset_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "seed": {
            "type": "integer"
          },
          "has_character": {
            "type": "boolean",
            "description": "true if she appears in the shot (use reference images); false = txt2img without reference"
          }
        }
      }
    },
    "vo_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "shot",
          "offset_s",
          "max_seconds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^v[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "delivery": {
            "type": "string",
            "description": "Breeze voice-direction instruction"
          },
          "shot": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "offset_s": {
            "type": "number",
            "minimum": 0
          },
          "max_seconds": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4.5
          }
        }
      }
    },
    "sound_cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "prompt",
          "duration_s"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^x[0-9]{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sfx",
              "drone",
              "ambience"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 5
          },
          "duration_s": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 30
          },
          "shot": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset_s": {
            "type": "number",
            "minimum": 0
          },
          "gain_db": {
            "type": "number",
            "minimum": -40,
            "maximum": 6
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "style",
        "lyrics_file",
        "target_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "minLength": 10
        },
        "lyrics_file": {
          "type": "string"
        },
        "target_seconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 180
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
