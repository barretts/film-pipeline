  ],
  "characters": {
    "kate": "Senior operator, remains at the base radio.",
    "james": "Field operator, checks the outer threshold.",
    "stranger": "Disembodied radio voice only."
  },
  "locations": {
    "interior": "Station control room, south side of the north wall.",
    "exterior": "Snow north of shared outer door, camera physically outdoors.",
    "black": "Editorial black."
  },
  "assets": {
    "james": {
      "label": "James",
      "parent": null,
      "references": [],
      "description": "Character turnaround on neutral gray: front and profile full body plus a large head study of the SAME man, late twenties, angular face, dark curly hair under charcoal earflap hat, faded vermilion survival suit with graphite knees, short black gloves and insulated boots. Empty hands."
    },
    "kate": {
      "label": "Kate",
      "parent": null,
      "references": [],
      "description": "Three studies of the SAME late-forties woman: full body standing, seated profile working at desk height, and face close-up. Short silver-streaked chestnut hair, lined expressive face, navy wool work jacket, cream crewneck sweater, brass ring on a short lanyard, dark trousers. Neutral backdrop."
    },
    "door": {
      "label": "Outer door and latch",
      "parent": "cabin",
      "references": [],
      "description": "Design reference pair of the same closed blue-grey insulated steel personnel hatch at a polar station, its interior face in front elevation plus a detail of its brushed horizontal silver latch. No window in door. Hinges left viewed from room, single handle right. Distinctive chipped lower corner."
    },
    "window": {
      "label": "Station window",
      "parent": "cabin",
      "references": [],
      "description": "A horizontal rectangular double-glazed polar cabin window with rounded corners and a charcoal metal frame. Frost at the edges. Blue-white snow visible outside. Straight-on architectural detail."
    },
    "desk": {
      "label": "Radio desk",
      "parent": "cabin",
      "references": [],
      "description": "Isolated empty broad utilitarian honey-toned birch plywood radio workbench, straight rectangular top, two square grey steel support frames. Three-quarter furniture photograph showing entire desk, no drawers or shelf."
    },
    "chair": {
      "label": "Kate’s chair",
      "parent": "cabin",
      "references": [],
      "description": "A single sturdy navy upholstered task chair, low back, no armrests, black metal footing. Front three-quarter furniture design photograph."
    },
    "desk_lamp": {
      "label": "Desk lamp",
      "parent": "desk",
      "references": [],
      "description": "Small amber-painted metal task lamp with conical shade, adjustable angled neck and heavy round base, switched on. Isolated object."
    },
    "receiver": {
      "label": "Base radio",
      "parent": "desk",
      "references": [],
      "description": "One squat charcoal steel tabletop transceiver. Front three-quarter catalog photograph: amber analog meter on left, six narrow vertical speaker slots on right of front face, one prominent black tuning knob below meter, small amber pilot. Wired mic jack at bottom right. No handset or antenna."
    },
    "mic": {
      "label": "Wired desk microphone",
      "parent": "desk",
      "references": [
        "receiver"
      ],
      "description": "Show the referenced base transceiver with its wired oval black desk microphone on a short silver stalk, black weighted push-to-talk foot and coiled black cable plugged into receiver. Entire connection visible on plain wood. The microphone is the foreground subject."
    },
    "walkie": {
      "label": "James’s walkie",
      "parent": null,
      "references": [],
      "description": "One narrow palm-sized charcoal rubber handheld two-way radio, short black antenna at upper left, distinctive mustard yellow side talk button, belt clip. Product reference showing front and side of same design. No cradle."
    },
    "charger": {
      "label": "Walkie charger",
      "parent": "desk",
      "references": [
        "walkie"
      ],
      "description": "Matched two-view product reference. Left: the referenced handheld radio seated upright in a low black desktop charging cradle. Right: same cradle empty, recessed socket and two brass contacts visible. Simple neutral background."
    },
    "cabin": {
      "label": "Station interior",
      "parent": null,
      "references": [
        "door",
        "window",
        "desk"
      ],
      "description": "Interior establishing photograph, camera looking across a cramped steel polar station radio room. Closed referenced hatch at back LEFT, referenced birch workbench at RIGHT beneath the referenced frosted window. Open walking aisle from hatch to desk, grounded floor, amber practical light and cold snow fill. Empty of people."
    },
    "workstation": {
      "label": "Dressed radio desk",
      "parent": "cabin",
      "references": [
        "mic",
        "charger",
        "desk_lamp",
        "chair"
      ],
      "description": "Integrated set detail at Kate's birch workbench below a frosted window. Match the supplied designs: transceiver at left, separate wired microphone in middle, handheld upright in charging cradle at right. Amber task lamp and low navy chair. Clearly distinguish the two radios. No people."
    },
    "exterior": {
      "label": "Station exterior",
      "parent": null,
      "references": [
        "door",
        "window",
        "cabin"
      ],
      "description": "Camera stands on the snow looking back at the OUTSIDE of the same single-storey steel polar cabin. Show corresponding outer face of the hatch, frosted window and the near corner of the building; retain plausible orientation relative to interior. Blue dusk, drifting snow. No people."
    }
